/*
 * cheat_keys.def - single source of truth for cheat-combo key names and bits.
 * Ported from re3 (src/skel/gbm/cheat_keys.def); CREATE renamed to SELECT
 * because the R36S pad has no DualSense Create button.
 *
 * Each row:  CHEAT_KEY(name, bit_index)
 *   name       config-file token (as written in cheats.ini), UPPERCASE
 *   bit_index  0..31 position in the uint32 key bitmask
 */

/* face buttons */
CHEAT_KEY(CROSS,     0)
CHEAT_KEY(CIRCLE,    1)
CHEAT_KEY(TRIANGLE,  2)
CHEAT_KEY(SQUARE,    3)
/* shoulders / triggers */
CHEAT_KEY(L1,        4)
CHEAT_KEY(R1,        5)
CHEAT_KEY(L2,        6)
CHEAT_KEY(R2,        7)
/* stick clicks */
CHEAT_KEY(L3,        8)
CHEAT_KEY(R3,        9)
/* menu buttons */
CHEAT_KEY(SELECT,   10)
CHEAT_KEY(START,    11)
/* dpad */
CHEAT_KEY(UP,       12)
CHEAT_KEY(DOWN,     13)
CHEAT_KEY(LEFT,     14)
CHEAT_KEY(RIGHT,    15)
